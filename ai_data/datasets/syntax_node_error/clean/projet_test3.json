                        "params": ["self", "checked"],
                        "code": [
                            "pseudo = self.name_input.text if self.name_input.text else 'Anonyme'",
                            "vol = self.volume_slider.value if self.volume_slider.enabled else 'N/A'",
                            "self.status_label.text = f'Profil sauvegardé : {pseudo} (Volume : {vol})'"
                        ],
                        "is_intern": false
                    }
                ]
